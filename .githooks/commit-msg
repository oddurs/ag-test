#!/usr/bin/env bash
# Strip machine attribution from every commit message, always.
# Installed via: git config core.hooksPath .githooks  (scripts/setup.sh)
set -euo pipefail

msg_file="$1"
[ -f "$msg_file" ] || exit 0

tmp="$msg_file.agentclean"

# Drop attribution trailers, generator footers and robot emoji lines.
LC_ALL=C sed \
  -e '/^[[:space:]]*Co-[Aa]uthored-[Bb]y:.*[Cc]laude/d' \
  -e '/^[[:space:]]*Co-[Aa]uthored-[Bb]y:.*noreply@anthropic\.com/d' \
  -e '/^[[:space:]]*Co-[Aa]uthored-[Bb]y:.*\[bot\]/d' \
  -e '/[Gg]enerated with .*[Cc]laude [Cc]ode/d' \
  -e '/[Gg]enerated by .*[Cc]laude/d' \
  -e '/^[[:space:]]*🤖/d' \
  -e '/https:\/\/claude\.ai\/code/d' \
  -e '/^[[:space:]]*Assisted-[Bb]y:/d' \
  "$msg_file" > "$tmp"

# Collapse the trailing blank lines those deletions leave behind.
awk 'BEGIN{blank=0}
     /^[[:space:]]*$/{blank++; next}
     {while(blank>0){print ""; blank--} print}' "$tmp" > "$msg_file"

rm -f "$tmp"

# A message that was *only* attribution is a bug, not a commit.
if ! grep -q '[^[:space:]]' "$msg_file"; then
  echo "commit-msg: message was empty after stripping attribution" >&2
  exit 1
fi
